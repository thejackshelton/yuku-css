{
  "name": "yuku-css",
  "version": "0.1.0",
  "description": "A fast CSS parser written in Zig, compiled to WebAssembly",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yuku-toolchain/yuku-css.git"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./ast": {
      "types": "./dist/ast.d.ts",
      "default": "./dist/ast.js"
    },
    "./codegen": {
      "types": "./dist/codegen.d.ts",
      "default": "./dist/codegen.js"
    },
    "./package.json": "./package.json"
  },
  "imports": {
    "#module": {
      "workerd": "./dist/module/workerd.js",
      "default": "./dist/module/inline.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "zig build && tsdown",
    "test": "bun run build && bun run sync && bun test",
    "typecheck": "tsc",
    "bench": "bun run build && node bench/index.ts",
    "corpus": "bun test/corpus.ts",
    "prepublishOnly": "bun run build",
    "sync": "bun test/sync.ts && bun tools/sync.ts"
  },
  "devDependencies": {
    "@types/bun": "1.4.3",
    "@types/css-tree": "3.2.0",
    "css-tree": "3.2.1",
    "postcss": "8.5.30",
    "tinybench": "6.2.2",
    "tsdown": "0.23.1",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=18"
  }
}
