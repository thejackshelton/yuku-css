{
  "name": "yuku-css",
  "version": "0.2.0",
  "description": "A fast CSS parser, printer and validator, written in Zig and compiled to WebAssembly",
  "keywords": [
    "ast",
    "css",
    "css-tree",
    "lexer",
    "parser",
    "printer",
    "validator",
    "wasm",
    "webassembly",
    "zig"
  ],
  "homepage": "https://github.com/thejackshelton/yuku-css#readme",
  "bugs": {
    "url": "https://github.com/thejackshelton/yuku-css/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thejackshelton/yuku-css.git"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./ast": {
      "types": "./dist/ast.d.ts",
      "default": "./dist/ast.js"
    },
    "./codegen": {
      "types": "./dist/codegen.d.ts",
      "default": "./dist/codegen.js"
    },
    "./lexer": {
      "types": "./dist/lexer.d.ts",
      "default": "./dist/lexer.js"
    },
    "./package.json": "./package.json"
  },
  "imports": {
    "#module": {
      "workerd": "./dist/module/workerd.js",
      "default": "./dist/module/inline.js"
    },
    "#lexer-module": {
      "workerd": "./dist/lexer/module/workerd.js",
      "default": "./dist/lexer/module/inline.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "zig build && tsdown",
    "test": "bun run build && bun run sync && bun test",
    "typecheck": "tsc",
    "bench": "bun run build && node bench/index.ts",
    "bench:full": "bun run build && node bench/full.ts",
    "bench:report": "node bench/report.ts",
    "bench:oxc": "node bench/oxc.ts",
    "corpus": "bun test/corpus.ts",
    "prepublishOnly": "bun run build",
    "sync": "bun test/sync.ts && bun tools/sync.ts"
  },
  "devDependencies": {
    "@adobe/css-tools": "4.5.0",
    "@biomejs/js-api": "6.0.0",
    "@biomejs/wasm-nodejs": "2.5.15",
    "@biomejs/wasm-web": "2.5.15",
    "@csstools/css-parser-algorithms": "4.0.2",
    "@csstools/css-tokenizer": "4.0.2",
    "@swc/css": "0.0.28",
    "@types/bun": "1.4.3",
    "@types/clean-css": "4.2.11",
    "@types/css-tree": "3.2.0",
    "@types/csso": "5.0.5",
    "@types/stylis": "4.2.7",
    "@webref/css": "8.7.5",
    "clean-css": "5.3.3",
    "css-tree": "3.2.1",
    "csso": "5.0.5",
    "esbuild": "0.28.2",
    "esbuild-wasm": "0.28.2",
    "lightningcss": "1.33.0",
    "lightningcss-wasm": "1.33.0",
    "oxfmt": "0.73.0",
    "playwright": "1.64.0",
    "postcss": "8.5.30",
    "prettier": "3.9.10",
    "rolldown": "1.2.13",
    "stylis": "4.4.0",
    "tsdown": "0.23.1",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=18"
  }
}
